package admin

import (
	"strings"

	"{{.ModulePath}}/dto"
	"{{.ModulePath}}/guxgen/api"

	"{{.GuxModule}}/core"
	"{{.GuxModule}}/ui"
)

// NavItem represents a navigation item in the sidebar.
type NavItem struct {
	Label  string
	Href   string
	Icon   string
	Active bool
}

// AdminLayout wraps admin pages with sidebar navigation.
// Use this as a layout wrapper for all admin routes.
//
// Example:
//
//	app.RouteGroup("/admin", core.WithBundle("admin")).
//	    Hybrid("/", AdminLayout(Dashboard)).
//	    Hybrid("/users", AdminLayout(Users))
func AdminLayout(page func(*core.Router) func() core.Node) func(*core.Router) func() core.Node {
	return func(r *core.Router) func() core.Node {
		// Get page content
		pageContent := page(r)

		return func() core.Node {
			// State for sidebar
			collapsed := r.StateBool("sidebar_collapsed", false)
			mobileOpen := r.StateBool("sidebar_mobile", false)
			userMenuOpen := r.StateBool("user_menu_open", false)

			// Current path for active state
			currentPath := r.Path()

			// Build navigation items
			navItems := []NavItem{
				{Label: "Dashboard", Href: "/admin", Icon: "home", Active: currentPath == "/admin"},
				{Label: "Users", Href: "/admin/users", Icon: "users", Active: strings.HasPrefix(currentPath, "/admin/users")},
				{Label: "Settings", Href: "/admin/settings", Icon: "settings", Active: currentPath == "/admin/settings"},
			}

			// Convert to SidebarItems
			var sidebarItems []core.Node
			for _, item := range navItems {
				sidebarItems = append(sidebarItems, ui.SidebarItem(ui.SidebarItemProps{
					Label:     item.Label,
					Href:      item.Href,
					Icon:      item.Icon,
					Active:    item.Active,
					Collapsed: collapsed.Get(),
				}))
			}

			// Get user from context
			var userName, userEmail string
			if user := r.User(); user != nil {
				userName = user.Name
				userEmail = user.Email
			} else {
				userName = "Guest"
				userEmail = ""
			}

			// Logout handler
			handleLogout := func() {
				api.Logout(func(resp dto.LogoutResponse, err error) {
					if err == nil && resp.Success {
						r.Navigate(resp.Redirect)
					}
				})
			}

			return ui.SidebarLayout(ui.SidebarLayoutProps{
				Sidebar: ui.Sidebar(ui.SidebarProps{
					Collapsed:     collapsed.Get(),
					MobileOpen:    mobileOpen.Get(),
					OnCloseMobile: func() { mobileOpen.Set(false) },
					Children: []core.Node{
						ui.SidebarHeader(ui.SidebarHeaderProps{
							Title:            "{{.AppName}}",
							Collapsed:        collapsed.Get(),
							OnToggleCollapse: func() { collapsed.Set(!collapsed.Get()) },
							OnCloseMobile:    func() { mobileOpen.Set(false) },
						}),
						ui.SidebarNav(ui.SidebarNavProps{
							Children: []core.Node{
								ui.SidebarSection(ui.SidebarSectionProps{
									Title:     "Main",
									Collapsed: collapsed.Get(),
									Children:  sidebarItems,
								}),
							},
						}),
						ui.SidebarFooter(ui.SidebarFooterProps{
							Collapsed: collapsed.Get(),
							Children: []core.Node{
								// User menu with dropdown
								userMenu(userName, userEmail, collapsed.Get(), userMenuOpen.Get(),
									func() { userMenuOpen.Set(!userMenuOpen.Get()) },
									handleLogout,
								),
							},
						}),
					},
				}),
				Children: []core.Node{
					ui.SidebarMain(ui.SidebarMainProps{
						Collapsed:    collapsed.Get(),
						MobileOpen:   mobileOpen.Get(),
						OnOpenMobile: func() { mobileOpen.Set(true) },
						HeaderTitle:  "Admin",
						Children: []core.Node{
							pageContent(),
						},
					}),
				},
			})
		}
	}
}

// userMenu creates a user display with a dropdown menu containing logout.
func userMenu(name, email string, collapsed, menuOpen bool, onToggle, onLogout func()) core.Node {
	// Base classes for the user button
	buttonClass := "flex items-center w-full rounded-lg transition-colors cursor-pointer text-gray-300 hover:bg-gray-700 hover:text-white"
	if collapsed {
		buttonClass += " justify-center p-2"
	} else {
		buttonClass += " gap-4 p-3"
	}

	var content []core.Node

	// Avatar
	content = append(content, ui.Avatar(ui.AvatarProps{
		Name:  name,
		Size:  ui.AvatarMD,
		Class: "flex-shrink-0",
	}))

	// User info (hidden when collapsed)
	if !collapsed {
		content = append(content,
			core.Div(core.Class("flex-1 min-w-0 text-left"),
				core.Div(core.Class("font-medium text-white text-sm truncate"), core.Text(name)),
				core.Div(core.Class("text-xs text-gray-400 truncate"), core.Text(email)),
			),
			// Chevron indicator
			ui.Icon(ui.IconProps{
				Name:  "chevron-up",
				Size:  ui.IconSM,
				Class: "text-gray-400",
			}),
		)
	}

	// Dropdown menu (positioned above the button)
	var dropdown core.Node = core.Frag()
	if menuOpen && !collapsed {
		dropdown = core.Div(core.Class("absolute bottom-full left-0 right-0 mb-2 bg-gray-700 rounded-lg shadow-lg overflow-hidden"),
			core.Div(core.Class("py-1"),
				// Logout button
				core.Button(core.Attrs{
					Type:    "button",
					Class:   "w-full px-4 py-2 text-left text-sm text-gray-300 hover:bg-gray-600 hover:text-white flex items-center gap-2",
					OnClick: onLogout,
				},
					ui.Icon(ui.IconProps{Name: "log-out", Size: ui.IconSM}),
					core.Text("Sign out"),
				),
			),
		)
	}

	return core.Div(core.Class("relative"),
		dropdown,
		core.Button(core.Attrs{
			Type:    "button",
			Class:   buttonClass,
			OnClick: onToggle,
		}, content...),
	)
}

// PageHeader creates a consistent page header with title and breadcrumbs.
func PageHeader(title, subtitle string, breadcrumbs []dto.Breadcrumb) core.Node {
	return ui.PageHeader(ui.PageHeaderProps{
		Title:       title,
		Subtitle:    subtitle,
		Breadcrumbs: toBreadcrumbs(breadcrumbs),
	})
}

func toBreadcrumbs(items []dto.Breadcrumb) []ui.BreadcrumbItem {
	result := make([]ui.BreadcrumbItem, len(items))
	for i, item := range items {
		result[i] = ui.BreadcrumbItem{Label: item.Label, Href: item.Href}
	}
	return result
}
