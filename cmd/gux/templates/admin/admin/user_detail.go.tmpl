package admin

import (
	"{{.ModulePath}}/dto"

	"{{.GuxModule}}/core"
	"{{.GuxModule}}/ui"
)

// UserDetail renders the user detail page.
func UserDetail(r *core.Router) func() core.Node {
	// State for editing
	isEditing := r.StateBool("editing", false)
	showDeleteConfirm := r.StateBool("delete_confirm", false)

	// Editable fields
	editName := r.StateString("edit_name", "")
	editEmail := r.StateString("edit_email", "")

	return func() core.Node {
		// Get user ID from route params
		userID := r.Param("id")

		// Sample user data - in real app, fetch from API based on userID
		user := struct {
			ID    string
			Name  string
			Email string
			Role  string
		}{
			ID:    userID,
			Name:  "User " + userID,
			Email: "user" + userID + "@example.com",
			Role:  "user",
		}

		// Initialize edit fields if not set
		if editName.Get() == "" {
			editName.Set(user.Name)
		}
		if editEmail.Get() == "" {
			editEmail.Set(user.Email)
		}

		// Delete confirmation modal
		var deleteModal core.Node = core.Frag()
		if showDeleteConfirm.Get() {
			deleteModal = core.Div(core.Class("fixed inset-0 bg-black/50 flex items-center justify-center z-50"),
				ui.Card(ui.CardProps{
					Class: "max-w-md mx-4",
					Children: []core.Node{
						ui.CardHeader(ui.CardHeaderProps{
							Children: []core.Node{
								core.H3(core.Class("text-lg font-semibold text-gray-900 dark:text-white"),
									core.Text("Delete User?")),
							},
						}),
						ui.CardContent(ui.CardContentProps{
							Children: []core.Node{
								core.P(core.Class("text-gray-600 dark:text-gray-400"),
									core.Text("Are you sure you want to delete "+user.Name+"? This action cannot be undone.")),
							},
						}),
						ui.CardFooter(ui.CardFooterProps{
							Class: "flex justify-end gap-2",
							Children: []core.Node{
								ui.Button(ui.ButtonProps{
									Variant: ui.ButtonSecondary,
									OnClick: func() { showDeleteConfirm.Set(false) },
									Children: []core.Node{core.Text("Cancel")},
								}),
								ui.Button(ui.ButtonProps{
									Variant: ui.ButtonDestructive,
									OnClick: func() {
										// In real app, call delete API here
										showDeleteConfirm.Set(false)
										r.Navigate("/admin/users")
									},
									Children: []core.Node{core.Text("Delete")},
								}),
							},
						}),
					},
				}),
			)
		}

		// Content based on edit mode
		var cardContent core.Node
		var footerButtons core.Node

		if isEditing.Get() {
			// Edit mode
			cardContent = ui.CardContent(ui.CardContentProps{
				Children: []core.Node{
					core.Div(core.Class("space-y-4"),
						core.Div(core.Attrs{},
							core.Label(core.Attrs{
								Class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1",
							}, core.Text("Name")),
							ui.Input(ui.InputProps{
								Type:     ui.InputText,
								Value:    editName.Get(),
								OnChange: func(v string) { editName.Set(v) },
							}),
						),
						core.Div(core.Attrs{},
							core.Label(core.Attrs{
								Class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1",
							}, core.Text("Email")),
							ui.Input(ui.InputProps{
								Type:     ui.InputEmail,
								Value:    editEmail.Get(),
								OnChange: func(v string) { editEmail.Set(v) },
							}),
						),
						detailRow("User ID", user.ID),
						detailRow("Role", user.Role),
					),
				},
			})
			footerButtons = core.Div(core.Class("flex gap-2"),
				ui.Button(ui.ButtonProps{
					Variant: ui.ButtonSecondary,
					OnClick: func() {
						// Cancel - reset fields
						editName.Set(user.Name)
						editEmail.Set(user.Email)
						isEditing.Set(false)
					},
					Children: []core.Node{core.Text("Cancel")},
				}),
				ui.Button(ui.ButtonProps{
					Variant: ui.ButtonPrimary,
					OnClick: func() {
						// In real app, call update API here
						isEditing.Set(false)
					},
					Children: []core.Node{core.Text("Save")},
				}),
			)
		} else {
			// View mode
			cardContent = ui.CardContent(ui.CardContentProps{
				Children: []core.Node{
					detailRow("User ID", user.ID),
					detailRow("Name", editName.Get()),
					detailRow("Email", editEmail.Get()),
					detailRow("Role", user.Role),
				},
			})
			footerButtons = core.Div(core.Class("flex gap-2"),
				ui.Button(ui.ButtonProps{
					Variant: ui.ButtonSecondary,
					OnClick: func() { isEditing.Set(true) },
					Children: []core.Node{core.Text("Edit")},
				}),
				ui.Button(ui.ButtonProps{
					Variant: ui.ButtonDestructive,
					OnClick: func() { showDeleteConfirm.Set(true) },
					Children: []core.Node{core.Text("Delete")},
				}),
			)
		}

		return core.Frag(
			deleteModal,
			PageHeader("User Details", "View user information", []dto.Breadcrumb{
				{Label: "Admin", Href: "/admin"},
				{Label: "Users", Href: "/admin/users"},
				{Label: editName.Get(), Href: ""},
			}),

			// User info card
			ui.Card(ui.CardProps{
				Children: []core.Node{
					ui.CardHeader(ui.CardHeaderProps{
						Children: []core.Node{
							core.Div(core.Class("flex items-center gap-4"),
								ui.Avatar(ui.AvatarProps{
									Name: editName.Get(),
									Size: ui.AvatarLG,
								}),
								core.Div(core.Attrs{},
									core.H2(core.Class("text-xl font-bold text-gray-900 dark:text-white"),
										core.Text(editName.Get())),
									core.P(core.Class("text-gray-500 dark:text-gray-400"),
										core.Text(editEmail.Get())),
								),
							),
						},
					}),
					cardContent,
					ui.CardFooter(ui.CardFooterProps{
						Class: "flex justify-between",
						Children: []core.Node{
							core.A(core.Attrs{
								Href:  "/admin/users",
								Class: "text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200",
							}, core.Text("← Back to Users")),
							footerButtons,
						},
					}),
				},
			}),
		)
	}
}

func detailRow(label, value string) core.Node {
	return core.Div(core.Class("flex justify-between py-3 border-b border-gray-200 dark:border-gray-700 last:border-0"),
		core.Span(core.Class("text-gray-500 dark:text-gray-400"), core.Text(label)),
		core.Span(core.Class("font-medium text-gray-900 dark:text-white"), core.Text(value)),
	)
}
