package admin

import (
	"strconv"

	"{{.ModulePath}}/dto"
	"{{.ModulePath}}/guxgen/api"

	"{{.GuxModule}}/core"
	"{{.GuxModule}}/ui"
)

// UserDetail renders the user detail page.
func UserDetail(r *core.Router) func() core.Node {
	// State for user data
	user := core.UseState(r, "user", dto.UserDetail{})
	loading := r.StateBool("loading", true)
	errorMsg := r.StateString("error", "")

	// State for editing
	isEditing := r.StateBool("editing", false)
	showDeleteConfirm := r.StateBool("delete_confirm", false)
	saving := r.StateBool("saving", false)

	// Editable fields
	editName := r.StateString("edit_name", "")
	editEmail := r.StateString("edit_email", "")

	// Get user ID from route params
	userIDStr := r.Param("id")
	userID, _ := strconv.ParseUint(userIDStr, 10, 64)

	// Fetch user on load (skip if already hydrated from SSR)
	r.OnLoad(func() {
		// If we already have user data from SSR hydration, don't re-fetch
		if user.Get().ID > 0 {
			loading.Set(false)
			// Initialize edit fields from hydrated data
			u := user.Get()
			if editName.Get() == "" {
				editName.Set(u.Name)
			}
			if editEmail.Get() == "" {
				editEmail.Set(u.Email)
			}
			return
		}

		api.Users.Get(uint(userID), func(result *dto.UserDetail, err error) {
			loading.Set(false)
			if err != nil {
				errorMsg.Set("Failed to load user")
				return
			}
			user.Set(*result)
			editName.Set(result.Name)
			editEmail.Set(result.Email)
		})
	})

	return func() core.Node {
		u := user.Get()

		// Error state
		if errorMsg.Get() != "" {
			return core.Frag(
				PageHeader("User Details", "View user information", []dto.Breadcrumb{
					{Label: "Admin", Href: "/admin"},
					{Label: "Users", Href: "/admin/users"},
					{Label: "Error", Href: ""},
				}),
				ui.Card(ui.CardProps{
					Children: []core.Node{
						ui.CardContent(ui.CardContentProps{
							Class: "py-8 text-center",
							Children: []core.Node{
								core.P(core.Class("text-red-500 dark:text-red-400 mb-4"),
									core.Text(errorMsg.Get())),
								core.A(core.Attrs{
									Href:  "/admin/users",
									Class: "text-blue-600 hover:text-blue-800 dark:text-blue-400",
								}, core.Text("Back to Users")),
							},
						}),
					},
				}),
			)
		}

		// Loading state
		if loading.Get() {
			return core.Frag(
				PageHeader("User Details", "View user information", []dto.Breadcrumb{
					{Label: "Admin", Href: "/admin"},
					{Label: "Users", Href: "/admin/users"},
					{Label: "Loading...", Href: ""},
				}),
				ui.Card(ui.CardProps{
					Children: []core.Node{
						ui.CardContent(ui.CardContentProps{
							Class: "py-8 text-center text-gray-500 dark:text-gray-400",
							Children: []core.Node{
								core.Text("Loading user..."),
							},
						}),
					},
				}),
			)
		}

		// Delete confirmation modal
		var deleteModal core.Node = core.Frag()
		if showDeleteConfirm.Get() {
			deleteModal = core.Div(core.Class("fixed inset-0 bg-black/50 flex items-center justify-center z-50"),
				ui.Card(ui.CardProps{
					Class: "max-w-md mx-4",
					Children: []core.Node{
						ui.CardHeader(ui.CardHeaderProps{
							Children: []core.Node{
								core.H3(core.Class("text-lg font-semibold text-gray-900 dark:text-white"),
									core.Text("Delete User?")),
							},
						}),
						ui.CardContent(ui.CardContentProps{
							Children: []core.Node{
								core.P(core.Class("text-gray-600 dark:text-gray-400"),
									core.Text("Are you sure you want to delete "+u.Name+"? This action cannot be undone.")),
							},
						}),
						ui.CardFooter(ui.CardFooterProps{
							Class: "flex justify-end gap-2",
							Children: []core.Node{
								ui.Button(ui.ButtonProps{
									Variant: ui.ButtonSecondary,
									OnClick: func() { showDeleteConfirm.Set(false) },
									Children: []core.Node{core.Text("Cancel")},
								}),
								ui.Button(ui.ButtonProps{
									Variant: ui.ButtonDestructive,
									OnClick: func() {
										api.Users.Delete(u.ID, func(err error) {
											if err == nil {
												showDeleteConfirm.Set(false)
												r.Navigate("/admin/users")
											}
										})
									},
									Children: []core.Node{core.Text("Delete")},
								}),
							},
						}),
					},
				}),
			)
		}

		// Content based on edit mode
		var cardContent core.Node
		var footerButtons core.Node

		if isEditing.Get() {
			// Edit mode
			cardContent = ui.CardContent(ui.CardContentProps{
				Children: []core.Node{
					core.Div(core.Class("space-y-4"),
						core.Div(core.Attrs{},
							core.Label(core.Attrs{
								Class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1",
							}, core.Text("Name")),
							ui.Input(ui.InputProps{
								Type:     ui.InputText,
								Value:    editName.Get(),
								OnChange: func(v string) { editName.Set(v) },
							}),
						),
						core.Div(core.Attrs{},
							core.Label(core.Attrs{
								Class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1",
							}, core.Text("Email")),
							ui.Input(ui.InputProps{
								Type:     ui.InputEmail,
								Value:    editEmail.Get(),
								OnChange: func(v string) { editEmail.Set(v) },
							}),
						),
						detailRow("User ID", userIDStr),
						detailRow("Role", u.Role),
					),
				},
			})
			footerButtons = core.Div(core.Class("flex gap-2"),
				ui.Button(ui.ButtonProps{
					Variant:  ui.ButtonSecondary,
					Disabled: saving.Get(),
					OnClick: func() {
						// Cancel - reset fields
						editName.Set(u.Name)
						editEmail.Set(u.Email)
						isEditing.Set(false)
					},
					Children: []core.Node{core.Text("Cancel")},
				}),
				ui.Button(ui.ButtonProps{
					Variant:  ui.ButtonPrimary,
					Disabled: saving.Get(),
					OnClick: func() {
						saving.Set(true)
						data := map[string]interface{}{
							"name":  editName.Get(),
							"email": editEmail.Get(),
						}
						api.Users.Update(u.ID, data, func(result *dto.UserDetail, err error) {
							saving.Set(false)
							if err == nil {
								user.Set(*result)
								isEditing.Set(false)
							}
						})
					},
					Children: []core.Node{
						core.Text(func() string {
							if saving.Get() {
								return "Saving..."
							}
							return "Save"
						}()),
					},
				}),
			)
		} else {
			// View mode
			cardContent = ui.CardContent(ui.CardContentProps{
				Children: []core.Node{
					detailRow("User ID", userIDStr),
					detailRow("Name", u.Name),
					detailRow("Email", u.Email),
					detailRow("Role", u.Role),
				},
			})
			footerButtons = core.Div(core.Class("flex gap-2"),
				ui.Button(ui.ButtonProps{
					Variant: ui.ButtonSecondary,
					OnClick: func() { isEditing.Set(true) },
					Children: []core.Node{core.Text("Edit")},
				}),
				ui.Button(ui.ButtonProps{
					Variant: ui.ButtonDestructive,
					OnClick: func() { showDeleteConfirm.Set(true) },
					Children: []core.Node{core.Text("Delete")},
				}),
			)
		}

		return core.Frag(
			deleteModal,
			PageHeader("User Details", "View user information", []dto.Breadcrumb{
				{Label: "Admin", Href: "/admin"},
				{Label: "Users", Href: "/admin/users"},
				{Label: u.Name, Href: ""},
			}),

			// User info card
			ui.Card(ui.CardProps{
				Children: []core.Node{
					ui.CardHeader(ui.CardHeaderProps{
						Children: []core.Node{
							core.Div(core.Class("flex items-center gap-4"),
								ui.Avatar(ui.AvatarProps{
									Name: u.Name,
									Size: ui.AvatarLG,
								}),
								core.Div(core.Attrs{},
									core.H2(core.Class("text-xl font-bold text-gray-900 dark:text-white"),
										core.Text(u.Name)),
									core.P(core.Class("text-gray-500 dark:text-gray-400"),
										core.Text(u.Email)),
								),
							),
						},
					}),
					cardContent,
					ui.CardFooter(ui.CardFooterProps{
						Class: "flex justify-between",
						Children: []core.Node{
							core.A(core.Attrs{
								Href:  "/admin/users",
								Class: "text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200",
							}, core.Text("\u2190 Back to Users")),
							footerButtons,
						},
					}),
				},
			}),
		)
	}
}

func detailRow(label, value string) core.Node {
	return core.Div(core.Class("flex justify-between py-3 border-b border-gray-200 dark:border-gray-700 last:border-0"),
		core.Span(core.Class("text-gray-500 dark:text-gray-400"), core.Text(label)),
		core.Span(core.Class("font-medium text-gray-900 dark:text-white"), core.Text(value)),
	)
}
