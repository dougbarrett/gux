package admin

import (
	"{{.ModulePath}}/dto"

	"{{.GuxModule}}/core"
	"{{.GuxModule}}/ui"
)

// Dashboard renders the admin dashboard page.
func Dashboard(r *core.Router) func() core.Node {
	return func() core.Node {
		return core.Frag(
			PageHeader("Dashboard", "Welcome to the admin panel", []dto.Breadcrumb{
				{Label: "Admin", Href: "/admin"},
			}),

			// Stats row
			core.Div(core.Class("grid grid-cols-1 md:grid-cols-3 gap-6 mb-8"),
				statCard("Total Users", "1,234", "+12%", "users"),
				statCard("Active Sessions", "89", "Currently online", "activity"),
				statCard("Storage Used", "2.4 GB", "of 10 GB", "database"),
			),

			// Recent activity
			ui.Card(ui.CardProps{
				Children: []core.Node{
					ui.CardHeader(ui.CardHeaderProps{
						Children: []core.Node{
							core.H3(core.Class("text-lg font-semibold text-gray-900 dark:text-white"),
								core.Text("Recent Activity"),
							),
						},
					}),
					ui.CardContent(ui.CardContentProps{
						Children: []core.Node{
							activityItem("User registered", "john@example.com", "2 minutes ago"),
							activityItem("Settings updated", "Admin", "15 minutes ago"),
							activityItem("User logged in", "jane@example.com", "1 hour ago"),
							activityItem("Password reset", "bob@example.com", "3 hours ago"),
						},
					}),
				},
			}),
		)
	}
}

func statCard(title, value, subtitle, icon string) core.Node {
	return ui.Card(ui.CardProps{
		Children: []core.Node{
			ui.CardContent(ui.CardContentProps{
				Class: "p-6",
				Children: []core.Node{
					core.Div(core.Class("flex items-center justify-between"),
						core.Div(core.Attrs{},
							core.Div(core.Class("text-sm font-medium text-gray-500 dark:text-gray-400"),
								core.Text(title)),
							core.Div(core.Class("text-2xl font-bold text-gray-900 dark:text-white mt-1"),
								core.Text(value)),
							core.Div(core.Class("text-sm text-gray-500 dark:text-gray-400 mt-1"),
								core.Text(subtitle)),
						),
						core.Div(core.Class("p-3 bg-blue-100 dark:bg-blue-900 rounded-lg"),
							ui.Icon(ui.IconProps{Name: icon, Size: ui.IconLG, Class: "text-blue-600 dark:text-blue-400"}),
						),
					),
				},
			}),
		},
	})
}

func activityItem(title, subtitle, time string) core.Node {
	return core.Div(core.Class("flex items-center justify-between py-3 border-b border-gray-200 dark:border-gray-700 last:border-0"),
		core.Div(core.Attrs{},
			core.Div(core.Class("font-medium text-gray-900 dark:text-white"), core.Text(title)),
			core.Div(core.Class("text-sm text-gray-500 dark:text-gray-400"), core.Text(subtitle)),
		),
		core.Div(core.Class("text-sm text-gray-400"), core.Text(time)),
	)
}
