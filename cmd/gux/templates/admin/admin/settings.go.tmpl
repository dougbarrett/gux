package admin

import (
	"{{.ModulePath}}/dto"

	"{{.GuxModule}}/core"
	"{{.GuxModule}}/ui"
)

// Settings renders the settings page.
// NOTE: This is a demo template. Settings functionality requires implementing
// a Settings model and corresponding API endpoints for your specific needs.
func Settings(r *core.Router) func() core.Node {
	// Form state (demo only - not persisted)
	siteName := r.StateString("site_name", "{{.AppName}}")
	siteEmail := r.StateString("site_email", "admin@example.com")
	maintenanceMode := r.StateBool("maintenance_mode", false)

	return func() core.Node {
		return core.Frag(
			PageHeader("Settings", "Configure application settings", []dto.Breadcrumb{
				{Label: "Admin", Href: "/admin"},
				{Label: "Settings", Href: "/admin/settings"},
			}),

			// Demo notice
			ui.Alert(ui.AlertProps{
				Variant: ui.AlertInfo,
				Message: "This is a demo settings page. To add real settings, create a Settings model and implement the corresponding API endpoints.",
				Class:   "mb-6",
			}),

			// General settings card
			ui.Card(ui.CardProps{
				Class: "mb-6",
				Children: []core.Node{
					ui.CardHeader(ui.CardHeaderProps{
						Children: []core.Node{
							core.H3(core.Class("text-lg font-semibold text-gray-900 dark:text-white"),
								core.Text("General Settings"),
							),
						},
					}),
					ui.CardContent(ui.CardContentProps{
						Children: []core.Node{
							// Site name
							core.Div(core.Class("mb-4"),
								core.Label(core.Attrs{
									Class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1",
									Extra: map[string]string{"for": "site_name"},
								}, core.Text("Site Name")),
								ui.Input(ui.InputProps{
									ID:       "site_name",
									Type:     ui.InputText,
									Value:    siteName.Get(),
									OnChange: func(v string) { siteName.Set(v) },
								}),
							),

							// Admin email
							core.Div(core.Class("mb-4"),
								core.Label(core.Attrs{
									Class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1",
									Extra: map[string]string{"for": "site_email"},
								}, core.Text("Admin Email")),
								ui.Input(ui.InputProps{
									ID:       "site_email",
									Type:     ui.InputEmail,
									Value:    siteEmail.Get(),
									OnChange: func(v string) { siteEmail.Set(v) },
								}),
							),

							// Maintenance mode toggle
							core.Div(core.Class("flex items-center justify-between py-4 border-t border-gray-200 dark:border-gray-700"),
								core.Div(core.Attrs{},
									core.Div(core.Class("font-medium text-gray-900 dark:text-white"),
										core.Text("Maintenance Mode")),
									core.Div(core.Class("text-sm text-gray-500 dark:text-gray-400"),
										core.Text("Temporarily disable public access")),
								),
								// Toggle button
								ui.Button(ui.ButtonProps{
									Variant: func() ui.ButtonVariant {
										if maintenanceMode.Get() {
											return ui.ButtonPrimary
										}
										return ui.ButtonSecondary
									}(),
									OnClick: func() { maintenanceMode.Set(!maintenanceMode.Get()) },
									Children: []core.Node{
										core.Text(func() string {
											if maintenanceMode.Get() {
												return "Enabled"
											}
											return "Disabled"
										}()),
									},
								}),
							),
						},
					}),
					ui.CardFooter(ui.CardFooterProps{
						Class: "flex justify-end",
						Children: []core.Node{
							core.Span(core.Class("text-sm text-gray-500 dark:text-gray-400 mr-4 self-center"),
								core.Text("(Demo - changes not saved)")),
							ui.Button(ui.ButtonProps{
								Variant:  ui.ButtonPrimary,
								Disabled: true,
								Children: []core.Node{
									core.Text("Save Changes"),
								},
							}),
						},
					}),
				},
			}),

			// Danger zone
			ui.Card(ui.CardProps{
				Class: "border-red-200 dark:border-red-800",
				Children: []core.Node{
					ui.CardHeader(ui.CardHeaderProps{
						Children: []core.Node{
							core.H3(core.Class("text-lg font-semibold text-red-600 dark:text-red-400"),
								core.Text("Danger Zone"),
							),
						},
					}),
					ui.CardContent(ui.CardContentProps{
						Children: []core.Node{
							core.Div(core.Class("flex items-center justify-between"),
								core.Div(core.Attrs{},
									core.Div(core.Class("font-medium text-gray-900 dark:text-white"),
										core.Text("Delete All Data")),
									core.Div(core.Class("text-sm text-gray-500 dark:text-gray-400"),
										core.Text("Permanently delete all users and data")),
								),
								ui.Button(ui.ButtonProps{
									Variant:  ui.ButtonDestructive,
									Disabled: true,
									Children: []core.Node{
										core.Text("Delete All"),
									},
								}),
							),
						},
					}),
				},
			}),
		)
	}
}
