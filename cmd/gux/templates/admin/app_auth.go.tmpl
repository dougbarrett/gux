package main

import (
	"errors"
	"fmt"
	"log"
	"os"

	"{{.ModulePath}}/admin"
	"{{.ModulePath}}/dto"
	"{{.ModulePath}}/guxgen/api"
	"{{.ModulePath}}/models"
	"{{.ModulePath}}/pages"

	"{{.GuxModule}}/core"
	"gorm.io/driver/sqlite"
	"gorm.io/gorm"
)

func main() {
	// Load environment variables
	core.LoadEnv(".env")

	// Set up database
	db, err := gorm.Open(sqlite.Open("{{.AppName}}.db"), &gorm.Config{})
	if err != nil {
		log.Fatal("Failed to connect database:", err)
	}

	// Auto-migrate models
	db.AutoMigrate(&models.User{})

	// Initialize API with database
	api.Init(db)

	// Seed admin user from environment variables
	var count int64
	db.Model(&models.User{}).Count(&count)
	if count == 0 {
		adminEmail := os.Getenv("ADMIN_EMAIL")
		adminPassword := os.Getenv("ADMIN_PASSWORD")

		if adminEmail == "" || adminPassword == "" {
			log.Println("Warning: ADMIN_EMAIL and ADMIN_PASSWORD not set in environment.")
			log.Println("Please set these in your .env file to create an admin user.")
		} else {
			adminUser := models.User{
				Email:    adminEmail,
				Name:     "Admin",
				Role:     "admin",
			}
			adminUser.SetPassword(adminPassword)
			db.Create(&adminUser)
			fmt.Println("Seeded admin user:", adminEmail)
		}
	}

	// Initialize app
	app := core.New()
	app.SetDB(db)
	app.SetTitle("{{.AppName}}")
	app.DarkMode() // Enable dark mode for admin panel

	// Configure authentication
	app.EnableAuth(core.AuthConfig{
		SessionStore: core.NewMemorySessionStore(),
		CookieName:   "__{{.AppName}}_session",
		CookieMaxAge: 86400 * 7, // 7 days
		LoginPath:    "/login",
	})

	// Register API endpoints
	registerAPIEndpoints(app, db)

	// Register CRUD for User with DTO and password hooks
	app.CRUD(models.User{},
		core.WithListDTO(dto.UserList{}),
		core.WithDetailDTO(dto.UserDetail{}),
		core.WithCreateHook(func(data map[string]interface{}) (interface{}, error) {
			user := &models.User{}
			if email, ok := data["email"].(string); ok {
				user.Email = email
			} else {
				return nil, errors.New("email is required")
			}
			if name, ok := data["name"].(string); ok {
				user.Name = name
			}
			if password, ok := data["password"].(string); ok && password != "" {
				if err := user.SetPassword(password); err != nil {
					return nil, errors.New("failed to hash password")
				}
			} else {
				return nil, errors.New("password is required")
			}
			// Set role from data, default to "user"
			if role, ok := data["role"].(string); ok && role != "" {
				user.Role = role
			} else {
				user.Role = "user"
			}
			return user, nil
		}),
		core.WithUpdateHook(func(existing interface{}, data map[string]interface{}) (interface{}, error) {
			user := existing.(*models.User)
			if name, ok := data["name"].(string); ok {
				user.Name = name
			}
			if email, ok := data["email"].(string); ok {
				user.Email = email
			}
			if role, ok := data["role"].(string); ok {
				user.Role = role
			}
			if password, ok := data["password"].(string); ok && password != "" {
				user.SetPassword(password)
			}
			return user, nil
		}),
	)

	// Redirect homepage to login
	app.Routes().
		Hybrid("/", pages.HomeRedirect).
		Hybrid("/login", pages.Login)
{{if .PublicSignup}}
	// Public registration
	app.Routes().
		Hybrid("/register", pages.Register)
{{end}}
	// Protected admin routes with sidebar layout
	app.RouteGroup("/admin", core.WithBundle("admin")).
		Protected().
		Hybrid("/", admin.AdminLayout(admin.Dashboard)).
		Hybrid("/users", admin.AdminLayout(admin.Users)).
		Hybrid("/users/new", admin.AdminLayout(admin.UserNew)).
		Hybrid("/users/:id", admin.AdminLayout(admin.UserDetail)).
		Hybrid("/users/:id/edit", admin.AdminLayout(admin.UserEdit)).
		Hybrid("/settings", admin.AdminLayout(admin.Settings))

	// Start server
	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}
	fmt.Printf("{{.AppName}} running at http://localhost:%s\n", port)
	fmt.Println("Login with your admin credentials from .env")
	app.Run(":" + port)
}

// registerAPIEndpoints sets up typed API endpoints.
func registerAPIEndpoints(app *core.App, db *gorm.DB) {
	// Login endpoint - must be Public() since users aren't authenticated yet
	core.API(app, "POST", "/api/login", func(ctx *core.APIContext, req dto.LoginRequest) (dto.LoginResponse, error) {
		// Find user
		var user models.User
		if err := db.Where("email = ?", req.Email).First(&user).Error; err != nil {
			return dto.LoginResponse{Error: "Invalid email or password"}, nil
		}

		// Check password
		if !user.CheckPassword(req.Password) {
			return dto.LoginResponse{Error: "Invalid email or password"}, nil
		}

		// Create session
		ctx.Login(&core.SessionUser{
			ID:    fmt.Sprintf("%d", user.ID),
			Email: user.Email,
			Name:  user.Name,
			Roles: []string{user.Role},
		})

		return dto.LoginResponse{
			Success:  true,
			Redirect: "/admin",
		}, nil
	}).Public()

	// Logout endpoint - must be Public() to allow logout even if session is invalid
	core.API(app, "POST", "/api/logout", func(ctx *core.APIContext, _ struct{}) (dto.LogoutResponse, error) {
		ctx.Logout()
		return dto.LogoutResponse{
			Success:  true,
			Redirect: "/login",
		}, nil
	}).Public()
}
