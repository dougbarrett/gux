.PHONY: build run clean

# Build everything into a single binary
build: .gux/dist/app.wasm .gux/dist/wasm_exec.js assets_gen.go
	go build -o bin/app .

# Generate WASM entry point
.gux/wasm/main.go:
	@mkdir -p .gux/wasm
	@echo '//go:build js && wasm' > .gux/wasm/main.go
	@echo '' >> .gux/wasm/main.go
	@echo 'package main' >> .gux/wasm/main.go
	@echo '' >> .gux/wasm/main.go
	@echo 'import (' >> .gux/wasm/main.go
	@echo '	"syscall/js"' >> .gux/wasm/main.go
	@echo '' >> .gux/wasm/main.go
	@echo '	"github.com/dougbarrett/gux/core"' >> .gux/wasm/main.go
	@echo '	"github.com/dougbarrett/gux/examples/minimal/pages"' >> .gux/wasm/main.go
	@echo ')' >> .gux/wasm/main.go
	@echo '' >> .gux/wasm/main.go
	@echo 'func main() {' >> .gux/wasm/main.go
	@echo '	document := js.Global().Get("document")' >> .gux/wasm/main.go
	@echo '	container := document.Call("getElementById", "app")' >> .gux/wasm/main.go
	@echo '' >> .gux/wasm/main.go
	@echo '	var router *core.Router' >> .gux/wasm/main.go
	@echo '	var render func()' >> .gux/wasm/main.go
	@echo '' >> .gux/wasm/main.go
	@echo '	render = func() {' >> .gux/wasm/main.go
	@echo '		container.Set("innerHTML", "")' >> .gux/wasm/main.go
	@echo '		component := pages.Home(router)' >> .gux/wasm/main.go
	@echo '		node := component()' >> .gux/wasm/main.go
	@echo '		result := node.Render(core.DOM())' >> .gux/wasm/main.go
	@echo '		if domVal := result.DOMValue(); domVal != nil {' >> .gux/wasm/main.go
	@echo '			container.Call("appendChild", domVal.(js.Value))' >> .gux/wasm/main.go
	@echo '		}' >> .gux/wasm/main.go
	@echo '	}' >> .gux/wasm/main.go
	@echo '' >> .gux/wasm/main.go
	@echo '	router = core.NewRouter(render)' >> .gux/wasm/main.go
	@echo '	render()' >> .gux/wasm/main.go
	@echo '' >> .gux/wasm/main.go
	@echo '	select {}' >> .gux/wasm/main.go
	@echo '}' >> .gux/wasm/main.go

# Build WASM using TinyGo
.gux/dist/app.wasm: .gux/wasm/main.go pages/home.go
	@mkdir -p .gux/dist
	tinygo build -o .gux/dist/app.wasm -target wasm ./.gux/wasm

# Copy wasm_exec.js from TinyGo installation
.gux/dist/wasm_exec.js:
	@mkdir -p .gux/dist
	cp "$$(tinygo env TINYGOROOT)/targets/wasm_exec.js" .gux/dist/

# Generate assets embedding file (must be in root for Go to compile it)
assets_gen.go: .gux/dist/app.wasm .gux/dist/wasm_exec.js
	@echo '// Code generated by make; DO NOT EDIT.' > assets_gen.go
	@echo 'package main' >> assets_gen.go
	@echo '' >> assets_gen.go
	@echo 'import (' >> assets_gen.go
	@echo '	_ "embed"' >> assets_gen.go
	@echo '' >> assets_gen.go
	@echo '	"github.com/dougbarrett/gux/core"' >> assets_gen.go
	@echo ')' >> assets_gen.go
	@echo '' >> assets_gen.go
	@echo '//go:embed .gux/dist/app.wasm' >> assets_gen.go
	@echo 'var wasmBinary []byte' >> assets_gen.go
	@echo '' >> assets_gen.go
	@echo '//go:embed .gux/dist/wasm_exec.js' >> assets_gen.go
	@echo 'var wasmExecJS []byte' >> assets_gen.go
	@echo '' >> assets_gen.go
	@echo 'func init() {' >> assets_gen.go
	@echo '	core.SetDefaultAssets(wasmBinary, wasmExecJS)' >> assets_gen.go
	@echo '}' >> assets_gen.go

# Build and run
run: build
	./bin/app

clean:
	rm -rf bin/ .gux/ assets_gen.go
