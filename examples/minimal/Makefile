.PHONY: build run clean

# Build everything into a single binary
build: cmd/app/dist/app.wasm cmd/app/dist/wasm_exec.js cmd/app/assets_gen.go
	go build -o bin/app ./cmd/app

# Build WASM from internal entry point using TinyGo
cmd/app/dist/app.wasm: internal/wasm/main.go pages/home.go
	@mkdir -p cmd/app/dist
	tinygo build -o cmd/app/dist/app.wasm -target wasm ./internal/wasm

# Copy wasm_exec.js from TinyGo installation
cmd/app/dist/wasm_exec.js:
	@mkdir -p cmd/app/dist
	cp "$$(tinygo env TINYGOROOT)/targets/wasm_exec.js" cmd/app/dist/

# Generate assets embedding file
cmd/app/assets_gen.go: cmd/app/dist/app.wasm cmd/app/dist/wasm_exec.js
	@echo '// Code generated by make; DO NOT EDIT.' > cmd/app/assets_gen.go
	@echo 'package main' >> cmd/app/assets_gen.go
	@echo '' >> cmd/app/assets_gen.go
	@echo 'import (' >> cmd/app/assets_gen.go
	@echo '	_ "embed"' >> cmd/app/assets_gen.go
	@echo '' >> cmd/app/assets_gen.go
	@echo '	"github.com/dougbarrett/gux/core"' >> cmd/app/assets_gen.go
	@echo ')' >> cmd/app/assets_gen.go
	@echo '' >> cmd/app/assets_gen.go
	@echo '//go:embed dist/app.wasm' >> cmd/app/assets_gen.go
	@echo 'var wasmBinary []byte' >> cmd/app/assets_gen.go
	@echo '' >> cmd/app/assets_gen.go
	@echo '//go:embed dist/wasm_exec.js' >> cmd/app/assets_gen.go
	@echo 'var wasmExecJS []byte' >> cmd/app/assets_gen.go
	@echo '' >> cmd/app/assets_gen.go
	@echo 'func init() {' >> cmd/app/assets_gen.go
	@echo '	core.SetDefaultAssets(wasmBinary, wasmExecJS)' >> cmd/app/assets_gen.go
	@echo '}' >> cmd/app/assets_gen.go

# Build and run
run: build
	./bin/app

clean:
	rm -rf bin/ cmd/app/dist/ cmd/app/assets_gen.go
